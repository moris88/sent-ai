{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git commit *)",
      "Bash(pnpm build)",
      "Bash(pnpm dev)",
      "Bash(pnpm clean)",
      "Bash(pnpm lint)"
    ],
    "deny": [
      "Bash(git push *)",
      "Read(./.env*)",
      "Read(./**/.env*)",
      "Read(./.npmrc)",
      "Read(./**/.npmrc)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/secrets/**)",
      "Read(./secrets.*)",
      "Read(./**/secrets.*)",
      "Read(./**/credentials/**)",
      "Read(./credentials.*)",
      "Read(./**/credentials.*)",
      "Read(./**/private/**)",
      "Edit(./.git/**)",
      "Edit(./node_modules/**)",
      "Edit(./app/**)",
      "Edit(./dist/**)",
      "Edit(./coverage/**)"
    ]
  }
}
