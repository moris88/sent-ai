{
  "name": "sent-ai",
  "private": true,
  "version": "0.0.0",
  "author": {
    "name": "Maurizio Tolomeo",
    "email": "mauriziotolomeo@outlook.it",
    "url": "https://mauriziotolomeo.it"
  },
  "desktopName": "SentAI",
  "description": "Email Refiner Application",
  "type": "module",
  "main": "out/main/main.js",
  "build": {
    "appId": "com.sentai.app",
    "productName": "SentAI",
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "icon": "resources/icon.png",
    "win": {
      "target": [
        "zip"
      ]
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "scripts": {
    "lint": "biome check ./src",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "node --env-file=.env scripts/start.js",
    "dev:web": "vite --port 3000",
    "dev:electron": "electron-vite dev -- --ozone-platform=x11",
    "preview": "vite preview",
    "preview:electron": "electron-vite preview",
    "build": "tsc -b && vite build",
    "build:electron": "pnpm clean && electron-vite build && electron-builder --win --linux --publish=never",
    "clean": "rimraf dist out",
    "electron:install": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.62.0",
    "openai": "^7.45.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^31.0.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
