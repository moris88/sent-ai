{
  "name": "sent-ai",
  "private": true,
  "version": "0.0.0",
  "author": {
    "name": "Maurizio Tolomeo",
    "email": "mauriziotolomeo@outlook.it",
    "url": "https://mauriziotolomeo.it"
  },
  "desktopName": "SentAI",
  "description": "Email Refiner Application",
  "type": "module",
  "main": "out/main/main.js",
  "build": {
    "appId": "com.sentai.app",
    "productName": "SentAI",
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "icon": "resources/icon.png",
    "win": {
      "target": [
        "zip"
      ]
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "scripts": {
    "lint": "biome check ./src",
    "dev": "node --env-file=.env scripts/start.js",
    "dev:web": "vite --port 3000",
    "dev:electron": "electron-vite dev -- --ozone-platform=x11",
    "preview": "vite preview",
    "preview:electron": "electron-vite preview",
    "build": "tsc -b && vite build",
    "build:electron": "pnpm clean && electron-vite build && electron-builder --win --linux --publish=never",
    "clean": "rimraf dist out"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.5",
    "@google/generative-ai": "^0.24.1",
    "lucide-react": "^1.61.0",
    "openai": "^6.49.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^17.4.2",
    "electron": "^43.8.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^5.0.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^0.21.2"
  }
}
